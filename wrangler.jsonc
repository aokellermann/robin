{
    "name": "robin",
    "compatibility_date": "2026-05-01",
    "compatibility_flags": ["global_fetch_strictly_public"],
    "main": "worker.js",
    "routes": [
        {
            "pattern": "robin.aok.site",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./public"
    },
    "kv_namespaces": [
        {
            "binding": "OAUTH_KV",
            "id": "526c7be479d541b6be6eea90220c6819"
        }
    ]
}
